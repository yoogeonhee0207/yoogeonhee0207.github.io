---
import { heatmap, daysAgo } from '../lib/data.js';
import { langOf, t } from '../lib/i18n.js';
const lang = langOf(Astro.url.pathname);
// commits: 커밋 배열 또는 날짜별 개수(dailyFor — 기록 전체 기준)
// wide: 잔디와 숫자를 한 줄(가로 띠)로 — 폭이 넓은 칸에서 씀
const { commits, weeks = 16, wide = false } = Astro.props;
const h = heatmap(commits, weeks);
---
<div class:list={["heat-box", { wide }]}>
  <div class="heat" role="img" aria-label={t(lang, 'heat.aria', weeks, h.activeDays, h.total)}>
    {h.cols.map((col) => (
      <div class="col">
        {col.map((d) => (
          <span class={`cell l${d.level}${d.future ? ' future' : ''}`} title={d.future ? '' : t(lang, 'heat.cell', d.date, d.count)}></span>
        ))}
      </div>
    ))}
  </div>
  <div class="stats small">
    <span><b>{h.total}</b> {t(lang, 'heat.commits')}</span>
    <span><b>{h.activeDays}</b>{lang === 'en' ? ' ' : ''}{t(lang, 'heat.days')}</span>
    {h.last && <span>{t(lang, 'heat.last')} <b>{daysAgo(h.last, lang)}</b></span>}
  </div>
</div>

<style>
  .heat-box { border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .heat { display: flex; gap: 3px; overflow-x: auto; padding-bottom: 2px; }
  .col { display: flex; flex-direction: column; gap: 3px; }
  .cell { width: 13px; height: 13px; border-radius: 3px; background: var(--heat-0); display: block; }
  .cell.l1 { background: var(--heat-1); } .cell.l2 { background: var(--heat-2); }
  .cell.l3 { background: var(--heat-3); } .cell.l4 { background: var(--heat-4); }
  .cell.future { background: transparent; }
  .stats { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--ink-2); }
  .stats b { color: var(--ink); }
  .wide { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding: 16px 20px; }
  .wide .heat { flex: 0 1 auto; min-width: 0; }
  .wide .stats { flex-direction: column; gap: 4px; font-size: 14px; }
  .wide .stats b { font-size: 20px; font-family: var(--mono); margin-right: 4px; }
  .wide .heat { scrollbar-width: none; }
  .wide .heat::-webkit-scrollbar { display: none; }
  /* 좁은 화면에서는 최근 12주만 (옛 주가 앞에 있어 최근 커밋이 잘리지 않게) */
  @media (max-width: 640px) {
    .wide .col:nth-last-child(n + 13) { display: none; }
    .wide .stats { flex-direction: row; gap: 4px 18px; }
    .wide .stats b { font-size: 16px; }
  }
</style>
