---
import { TYPES, fmtDate } from '../lib/data.js';
// commits: [{sha,date,type,msg,dev?}]  milestones: { "커밋 메시지": "표시할 이름" }
// build: 게임 JSON의 build ({number, version}). dev: true 인 커밋(올린 빌드 뒤에 쌓인 것)이 있으면
// '개발 중'과 '빌드에 포함됨' 두 칸으로 나눠 보여 준다. 없으면 예전처럼 한 목록.
// initial: 칸마다 처음 보이는 개수, step: '더 보기'를 누를 때마다 늘어나는 개수
const { commits = [], milestones = {}, initial = 20, step = initial, build = null } = Astro.props;
const dev = commits.filter((c) => c.dev);
const groups = dev.length > 0
  ? [
      { id: 'dev', title: '개발 중', tag: '', note: `다음 빌드에 들어갈 내용`, items: dev },
      { id: 'in', title: build ? '' : '빌드에 포함', tag: build ? `v${build.version} · 빌드 ${build.number}` : '', note: '에 들어간 내용', items: commits.filter((c) => !c.dev) },
    ]
  : [{ id: 'all', title: '', tag: '', note: '', items: commits }];
const types = [...new Set(commits.map((c) => c.type))].sort((a, b) => commits.filter((c) => c.type === b).length - commits.filter((c) => c.type === a).length);
---
<div class="tl" data-timeline data-initial={initial} data-step={step}>
  {types.length > 1 && (
    <div class="chips" role="group" aria-label="커밋 종류로 거르기">
      <button type="button" class="f" data-f="all" aria-pressed="true">전체 <span>{commits.length}</span></button>
      {types.map((t) => (
        <button type="button" class="f" data-f={t} aria-pressed="false" title={TYPES[t] ?? t}>
          {t} <span>{commits.filter((c) => c.type === t).length}</span>
        </button>
      ))}
    </div>
  )}
  {commits.length === 0 ? (
    <p class="empty">아직 가져온 커밋 기록이 없어요.</p>
  ) : (
    groups.map((g) => (
      <section class={`group ${g.id}`} data-group>
        {(g.title || g.tag) && (
          <header class="gh">
            {g.id === 'dev' && <span class="live" aria-hidden="true"></span>}
            {g.title && <span class="gt">{g.title}</span>}
            {g.tag && <span class="tag mono">{g.tag}</span>}
            <span class="small muted">{g.note}</span>
            <span class="count mono" data-count>{g.items.length}</span>
          </header>
        )}
        <ol class="list">
          {g.items.map((c, i) => (
            <li data-type={c.type} class:list={[c.type, { ms: milestones[c.msg] }]} hidden={i >= initial}>
              <time class="mono" datetime={c.date}>{fmtDate(c.date)}</time>
              <div class="body">
                <p class="msg"><span class={`type ${c.type}`}>{c.type}</span>{c.msg}</p>
                {milestones[c.msg] && <span class="ms-tag">★ {milestones[c.msg]}</span>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  )}
  {groups.some((g) => g.items.length > initial) && <button type="button" class="more" data-more>더 보기</button>}
</div>

<script>
  document.querySelectorAll('[data-timeline]').forEach((root) => {
    const first = Number(root.dataset.initial) || 20;
    const step = Number(root.dataset.step) || first;
    const items = [...root.querySelectorAll('li')];
    const chips = [...root.querySelectorAll('.f')];
    const more = root.querySelector('[data-more]');
    let filter = 'all';
    let shown = first;
    const render = () => {
      // 칸(개발 중 / 빌드에 포함)마다 따로 shown개까지 보여 준다
      let rest = 0;
      items.forEach((li) => (li.hidden = true));
      root.querySelectorAll('[data-group]').forEach((g) => {
        const match = [...g.querySelectorAll('li')].filter((li) => filter === 'all' || li.dataset.type === filter);
        match.slice(0, shown).forEach((li) => (li.hidden = false));
        g.hidden = match.length === 0; // 보일 커밋이 없는 칸은 제목까지 숨긴다
        const cnt = g.querySelector('[data-count]');
        if (cnt) cnt.textContent = match.length;
        if (match.length > shown) rest += match.length - shown;
      });
      if (more) {
        more.hidden = !rest;
        more.textContent = `더 보기 · ${rest}개 남음`;
      }
    };
    chips.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.f;
        shown = first;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
        render();
      }),
    );
    more?.addEventListener('click', () => {
      shown += step;
      render();
    });
    render();
  });
</script>

<style>
  .tl { display: flex; flex-direction: column; gap: 14px; }
  /* 종류 거르기: 한 줄로, 넘치면 옆으로 밀어 보기 */
  .chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .chips::-webkit-scrollbar { display: none; }
  .f { flex: none; min-height: 32px; padding: 0 11px; border-radius: 999px; border: 1px solid var(--chip); background: var(--bg); color: var(--ink-2); font: 12px var(--mono); cursor: pointer; }
  .f span { color: var(--muted); margin-left: 2px; }
  .f:hover { border-color: var(--ink-2); }
  .f[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .f[aria-pressed='true'] span { color: inherit; opacity: .7; }

  /* 칸 = 카드 하나 */
  .group { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--bg); }
  .group[hidden] { display: none; }
  .group.dev { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .gh { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; margin: 0; padding: 12px 16px; background: var(--soft); border-bottom: 1px solid var(--line); }
  .group.dev .gh { background: var(--amber-bg); border-bottom-color: color-mix(in srgb, var(--accent) 30%, var(--line)); }
  .gt { font-weight: 700; font-size: 15px; }
  .group.dev .gt { color: var(--amber-fg); }
  .group.dev .gh .muted { color: var(--amber-fg); opacity: .8; }
  .tag { font-size: 13px; font-weight: 500; padding: 1px 8px; border-radius: 6px; background: var(--bg); border: 1px solid var(--chip); }
  .count { margin-left: auto; font-size: 12px; color: var(--muted); }
  .group.dev .count { color: var(--amber-fg); }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); animation: live 2s infinite; }
  @keyframes live { 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  @media (prefers-reduced-motion: reduce) { .live { animation: none; } }

  /* 커밋 한 줄 */
  .list { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding: 12px 16px; border-top: 1px solid var(--line-2); }
  li:first-child { border-top: 0; }
  li[hidden] { display: none; }
  li time { font-size: 12px; color: var(--muted); padding-top: 3px; }
  .body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .msg { font-size: 15px; line-height: 1.55; overflow-wrap: anywhere; }
  .msg .type { margin-right: 8px; vertical-align: 1px; }
  li.ms { background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%); box-shadow: inset 3px 0 0 var(--accent); }
  .ms-tag { align-self: flex-start; font-size: 12px; font-weight: 700; color: var(--accent-ink); }

  .more { min-height: 44px; border: 1px dashed var(--chip); border-radius: 10px; background: transparent; color: var(--ink-2); font: 500 14px var(--sans); cursor: pointer; }
  .more:hover { border-color: var(--ink-2); color: var(--ink); }
  .more[hidden] { display: none; }
</style>
