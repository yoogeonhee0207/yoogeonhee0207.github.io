---
import GameCard from './GameCard.astro';
import { dailyFor, postsFor, storyFor, fmtDate, gameIn } from '../lib/data.js';
import { langOf, L, t } from '../lib/i18n.js';
const lang = langOf(Astro.url.pathname);
// 게임 목록의 한 칸: 카드 + 그 게임 구역으로 가는 링크(소설·블로그·소개)와 올린 빌드·마지막 작업일
const { game: raw } = Astro.props;
const game = gameIn(raw, lang);
const base = L(lang, `/games/${game.slug}/`);
const last = Object.keys(dailyFor(game.slug)).sort().at(-1);
const b = game.webgl ? game.build : null;
const links = [
  ...(storyFor(game.slug).length > 0 ? [{ href: base + 'story/', label: t(lang, 'zone.story') }] : []),
  ...(game.gallery?.length > 0 ? [{ href: base + 'assets/', label: t(lang, 'zone.assets') }] : []),
  { href: base + 'blog/', label: t(lang, 'link.blog', postsFor(game.slug).length) },
  { href: base + 'about/', label: t(lang, 'zone.about') },
];
const when = [b && t(lang, 'build.tag', b.version, b.number), last && t(lang, 'lastWork', fmtDate(last))].filter(Boolean).join(' · ');
---
<div class="item">
  <GameCard game={raw} />
  <div class="meta small">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {when && <span class="muted mono when">{when}</span>}
  </div>
</div>

<style>
  .item { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .item > :global(.card) { flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center; padding: 0 4px; }
  .meta a { color: var(--accent-ink); font-weight: 500; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .when { margin-left: auto; }
</style>
