---
import { fmtDate, gameBySlug, gameIn } from '../lib/data.js';
import { langOf, t } from '../lib/i18n.js';
const lang = langOf(Astro.url.pathname); // 영어 페이지에서도 글은 한국어 — 'Korean' 표시
// posts: 글 목록 (최신 먼저). showGame: 여러 게임 글이 섞인 목록에서 어느 게임 글인지 보여 준다.
const { posts = [], showGame = false } = Astro.props;
---
<ul class="list">
  {posts.map((p) => (
    <li>
      <a href={p.url} hreflang={lang === 'en' ? 'ko' : undefined}>
        <time class="mono small muted" datetime={p.date}>{fmtDate(p.date, true)}</time>
        <span class="t" lang="ko">{p.title}{lang === 'en' && <span class="ko-tag mono">{t(lang, 'koreanOnly')}</span>}</span>
        {(p.description || (showGame && p.game)) && (
          <span class="d small muted">{showGame && p.game && <span class="g">{gameIn(gameBySlug(p.game), lang).title}</span>}<span lang="ko">{p.description}</span></span>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .ko-tag { margin-left: 8px; font-size: 11px; font-weight: 400; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 1px 7px; vertical-align: 2px; }
  .list { list-style: none; margin: 32px 0 0; padding: 0; max-width: 760px; }
  .list a { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: 2px 16px; padding: 18px 0; border-bottom: 1px solid var(--line-2); text-decoration: none; }
  .t { font-weight: 500; font-size: 17px; }
  .d { grid-column: 2; }
  .g { color: var(--accent-ink); font-weight: 500; }
  .g::after { content: ' · '; color: var(--muted); font-weight: 400; }
  @media (max-width: 560px) { .list a { grid-template-columns: minmax(0, 1fr); } .d { grid-column: 1; } }
</style>
