---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { posts, games, postsFor, gameIn } from '../../../lib/data.js';
import { langOf, withLang, L, t } from '../../../lib/i18n.js';

export const getStaticPaths = () => withLang();
const lang = langOf(Astro.url.pathname);

// 모든 게임의 글을 한데 모은 목록. 게임별 블로그는 /games/<게임>/blog/
const withPosts = games.filter((g) => postsFor(g.slug).length > 0);
---
<Base title={t(lang, 'blog.title')} description={t(lang, 'blog.desc')}>
  <h1>{t(lang, 'blog.title')}</h1>
  <p class="lead">{t(lang, 'blog.lead')}</p>
  {withPosts.length > 0 && (
    <p class="by small">
      <span class="muted">{t(lang, 'blog.byGame')}</span>
      {withPosts.map((g) => <a href={L(lang, `/games/${g.slug}/blog/`)}>{gameIn(g, lang).title} <span class="muted">{postsFor(g.slug).length}</span></a>)}
    </p>
  )}
  {posts.length === 0 ? (
    <p class="empty" style="margin-top: 32px">{t(lang, 'blog.empty')}</p>
  ) : (
    <PostList posts={posts} showGame />
  )}
</Base>

<style>
  h1 { font-size: 36px; }
  .lead { margin-top: 10px; color: var(--ink-2); font-size: 17px; }
  .by { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; }
  .by a { color: var(--accent-ink); font-weight: 500; text-decoration: none; }
</style>
