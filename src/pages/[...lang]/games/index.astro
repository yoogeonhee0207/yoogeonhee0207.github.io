---
import Base from '../../../layouts/Base.astro';
import GameItem from '../../../components/GameItem.astro';
import { games } from '../../../lib/data.js';
import { langOf, withLang, t } from '../../../lib/i18n.js';

export const getStaticPaths = () => withLang();
const lang = langOf(Astro.url.pathname);

// 게임을 모아 보는 페이지. 게임마다 홈 · 소설 · 블로그 · 소개가 따로 있다 (src/data/games/*.json 하나 = 게임 하나).
---
<Base title={t(lang, 'games.title')} description={t(lang, 'games.desc')}>
  <h1>{t(lang, 'games.title')}</h1>
  <p class="lead">{t(lang, 'games.lead')}</p>
  <div class="grid">
    {games.map((g) => <GameItem game={g} />)}
  </div>
</Base>

<style>
  h1 { font-size: 36px; }
  .lead { margin-top: 10px; color: var(--ink-2); font-size: 17px; }
  .grid { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 28px 24px; }
</style>
