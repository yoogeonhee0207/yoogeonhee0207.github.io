---
import Base from '../../../../../layouts/Base.astro';
import { games, commitsFor, dailyFor, sumDaily, postsFor, storyFor, STATUS, siteIn, gameIn, fmtDate } from '../../../../../lib/data.js';
import { langOf, withLang, L, t } from '../../../../../lib/i18n.js';

// 게임 소개: 그 게임이 어떤 게임이고 어떻게 만들고 있는지. 만든 사람 소개는 /about/ 하나를 같이 쓴다.
export function getStaticPaths() {
  return withLang(games.map((game) => ({ params: { slug: game.slug }, props: { game } })));
}
const lang = langOf(Astro.url.pathname);
const game = gameIn(Astro.props.game, lang);
const site = siteIn(lang);
const base = L(lang, `/games/${game.slug}/`);
const b = game.webgl ? game.build : null;
const info = [
  ...(game.info ?? []),
  ...(b ? [{ label: t(lang, 'build.label'), value: t(lang, 'build.full', b.version, b.number, b.date.replaceAll('-', '.')) }] : []),
];
const commits = commitsFor(game.slug)?.commits ?? [];
const posts = postsFor(game.slug);
const story = storyFor(game.slug);
const daily = dailyFor(game.slug);
const last = Object.keys(daily).sort().at(-1);
const links = [
  { href: base, label: game.title, text: t(lang, 'about.playText') },
  ...(story.length > 0 ? [{ href: base + 'story/', label: `${t(lang, 'about.novel')}${game.story?.title ? (lang === 'en' ? ` ${game.story.title}` : ` 『${game.story.title}』`) : ''}`, text: t(lang, 'about.chapters', story.length) }] : []),
  ...(game.gallery?.length > 0 ? [{ href: base + 'assets/', label: t(lang, 'about.assets'), text: t(lang, 'about.assetsText', game.gallery.length) }] : []),
  { href: base + 'blog/', label: t(lang, 'zone.blog'), text: posts.length > 0 ? t(lang, 'about.posts', posts.length) : t(lang, 'about.noPosts') },
  ...(commits.length > 0 ? [{ href: base + '#devlog', label: t(lang, 'game.devlog'), text: `${t(lang, 'about.commits', sumDaily(daily))}${last ? ` · ${t(lang, 'lastWork', fmtDate(last, true))}` : ''}` }] : []),
];
---
<Base title={t(lang, 'about.title', game.title)} description={game.summary} image={game.cover}>
  <div class="about">
    <div class="row" style="gap: 8px">
      <span class={`badge ${STATUS[game.status] ?? 'gray'}`}>{t(lang, `status.${game.status}`)}</span>
      <span class="mono small muted">{game.genre}</span>
    </div>
    <h1>{game.title} {game.titleEn && <span class="en">{game.titleEn}</span>}</h1>
    <p class="lead">{game.description}</p>
    <div class="row" style="gap: 6px">{game.tags?.map((t) => <span class="chip">{t}</span>)}</div>

    {info.length > 0 && (
      <section class="block">
        <h2>{t(lang, 'game.info')}</h2>
        <dl class="info">
          {info.map((k) => (<><dt>{k.label}</dt><dd>{k.value}</dd></>))}
        </dl>
      </section>
    )}

    <section class="block">
      <h2>{t(lang, 'about.browse')}</h2>
      <ul class="links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a> <span class="muted small">· {l.text}</span></li>
        ))}
      </ul>
    </section>

    <section class="block maker">
      <h2>{t(lang, 'about.maker')}</h2>
      <p class="small" style="color: var(--ink-2)">{site.name} · {site.bio}</p>
      <p class="small"><a href={L(lang, '/about/')}>{t(lang, 'about.makerLink')}</a> <span class="muted">·</span> <a href={L(lang, `/contact/?game=${game.slug}`)}>{t(lang, 'about.contactLink')}</a></p>
    </section>
  </div>
</Base>

<style>
  .about { max-width: 720px; display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: clamp(28px, 4vw, 36px); }
  .en { font-size: 19px; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .lead { font-size: 17px; color: var(--ink-2); }
  .block { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; }
  h2 { font-size: 20px; }
  .info { margin: 0; display: grid; grid-template-columns: 5.5em minmax(0, 1fr); gap: 8px 16px; font-size: 15px; }
  .info dt { color: var(--muted); }
  dd { margin: 0; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .links a, .maker a { color: var(--accent-ink); }
  .maker { background: var(--soft); border-radius: 12px; padding: 22px; }
</style>
