---
import Base from '../../../../../layouts/Base.astro';
import { games, gameBySlug, gameIn, storyFor } from '../../../../../lib/data.js';
import { langOf, LANGS, L, t } from '../../../../../lib/i18n.js';

export function getStaticPaths() {
  // 편 페이지는 그 언어 원고가 있는 것만 (영어 번역 전에는 한국어만)
  return LANGS.flatMap((lang) => games.flatMap((game) => {
    const chapters = storyFor(game.slug, lang);
    return chapters.map((c, i) => ({ params: { lang: lang === 'ko' ? undefined : lang, slug: game.slug, chapter: c.slug }, props: { c, prev: chapters[i - 1], next: chapters[i + 1] } }));
  }));
}
const { c, prev, next } = Astro.props;
const { Content } = c;
const lang = langOf(Astro.url.pathname);
const game = gameIn(gameBySlug(Astro.params.slug), lang);
const title = game.story?.title ?? t(lang, 'story.gameNovel', game.title);
const enHas = storyFor(game.slug, 'en').some((x) => x.slug === c.slug);
const alt = lang === 'ko' && !enHas ? L('en', `/games/${game.slug}/story/`) : undefined;
const same = title === game.title; // 소설 제목이 게임 이름과 같을 때 겹쳐 쓰지 않는다
const base = L(lang, `/games/${game.slug}/story`);
---
<Base title={`${c.label} ${c.title} — ${same ? t(lang, 'story.gameNovel', title) : title}`} description={t(lang, 'story.chapterDesc', title, c.label, c.title)} image={game.cover} alt={alt}>
  <article class="chapter">
    <p class="crumb small"><a href={`${base}/`}>← {same ? t(lang, 'story.toc') : title}</a></p>
    <p class="label mono small">{c.label}</p>
    <h1>{c.title}</h1>
    <div class="novel"><Content /></div>
    <nav class="pager" aria-label={t(lang, 'story.other')}>
      {prev ? <a href={`${base}/${prev.slug}/`} class="prev"><span class="small muted">{t(lang, 'story.prev')}</span><span class="t">{prev.label} {prev.title}</span></a> : <span></span>}
      {next ? <a href={`${base}/${next.slug}/`} class="next"><span class="small muted">{t(lang, 'story.next')}</span><span class="t">{next.label} {next.title}</span></a> : <a href={`${base}/`} class="next"><span class="small muted">{t(lang, 'story.end')}</span><span class="t">{t(lang, 'story.toToc')}</span></a>}
    </nav>
  </article>
</Base>

<style>
  .chapter { max-width: 640px; margin: 0 auto; }
  .crumb a { text-decoration: none; }
  .label { margin-top: 24px; color: var(--accent-ink); letter-spacing: .04em; }
  h1 { font-size: clamp(28px, 4.5vw, 36px); margin-top: 6px; }
  /* 웹소설 호흡: 짧은 문단, 넉넉한 줄 간격 */
  .novel { margin-top: 40px; font-size: 17px; line-height: 1.9; color: var(--ink); word-break: keep-all; overflow-wrap: break-word; }
  .novel :global(p) { margin: 0 0 1.1em; }
  .novel :global(h2) { margin: 3em 0 1.4em; padding-top: 1.6em; border-top: 1px solid var(--line); font-size: 19px; text-align: center; color: var(--ink-2); }
  .novel :global(hr) { border: 0; margin: 2.4em 0; text-align: center; }
  .novel :global(hr)::after { content: '· · ·'; color: var(--muted); }
  .novel :global(blockquote) { margin: 1.4em 0; padding-left: 16px; border-left: 2px solid var(--accent); color: var(--ink-2); }
  .pager { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; }
  .pager a:hover { border-color: var(--ink-2); color: inherit; }
  .pager .next { text-align: right; }
  .pager .t { font-weight: 500; font-size: 15px; }
</style>
