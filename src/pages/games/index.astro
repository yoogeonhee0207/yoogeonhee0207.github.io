---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { games, commitsFor, postsFor, storyFor, fmtDate } from '../../lib/data.js';

// 게임을 모아 보는 페이지. 게임마다 홈 · 소설 · 블로그 · 소개가 따로 있다 (src/data/games/*.json 하나 = 게임 하나).
const rows = games.map((game) => {
  const base = `/games/${game.slug}/`;
  const commits = commitsFor(game.slug)?.commits ?? [];
  const last = commits.map((c) => c.date).sort().at(-1);
  const b = game.webgl ? game.build : null;
  return {
    game,
    last,
    build: b ? `v${b.version} · 빌드 ${b.number}` : '',
    links: [
      ...(storyFor(game.slug).length > 0 ? [{ href: base + 'story/', label: '소설' }] : []),
      { href: base + 'blog/', label: `블로그 ${postsFor(game.slug).length}` },
      { href: base + 'about/', label: '소개' },
    ],
  };
});
---
<Base title="게임" description="만들고 있는 게임들. 게임마다 소개와 개발 일지가 따로 있어요.">
  <h1>게임</h1>
  <p class="lead">만들고 있는 게임이에요. 게임마다 소개와 블로그가 따로 있어요.</p>
  <div class="grid">
    {rows.map((r) => (
      <div class="item">
        <GameCard game={r.game} />
        <div class="meta small">
          {r.links.map((l) => <a href={l.href}>{l.label}</a>)}
          {(r.build || r.last) && <span class="muted mono when">{[r.build, r.last && `마지막 작업 ${fmtDate(r.last)}`].filter(Boolean).join(' · ')}</span>}
        </div>
      </div>
    ))}
  </div>
</Base>

<style>
  h1 { font-size: 36px; }
  .lead { margin-top: 10px; color: var(--ink-2); font-size: 17px; }
  .grid { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 28px 24px; }
  .item { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .item > :global(.card) { flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center; padding: 0 4px; }
  .meta a { color: var(--accent-ink); font-weight: 500; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .when { margin-left: auto; }
</style>
