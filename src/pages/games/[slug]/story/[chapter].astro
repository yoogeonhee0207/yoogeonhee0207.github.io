---
import Base from '../../../../layouts/Base.astro';
import { games, gameBySlug, storyFor } from '../../../../lib/data.js';

export function getStaticPaths() {
  return games.flatMap((game) => {
    const chapters = storyFor(game.slug);
    return chapters.map((c, i) => ({ params: { slug: game.slug, chapter: c.slug }, props: { c, prev: chapters[i - 1], next: chapters[i + 1] } }));
  });
}
const { c, prev, next } = Astro.props;
const { Content } = c;
const game = gameBySlug(Astro.params.slug);
const title = game.story?.title ?? `${game.title} 소설`;
const base = `/games/${game.slug}/story`;
---
<Base title={`${c.label} ${c.title} — ${title}`} description={`${game.title} 소설 『${title}』 ${c.label} 「${c.title}」`} image={game.cover}>
  <article class="chapter">
    <p class="crumb small"><a href={`${base}/`}>← {title}</a></p>
    <p class="label mono small">{c.label}</p>
    <h1>{c.title}</h1>
    <div class="novel"><Content /></div>
    <nav class="pager" aria-label="다른 편">
      {prev ? <a href={`${base}/${prev.slug}/`} class="prev"><span class="small muted">← 이전 편</span><span class="t">{prev.label} {prev.title}</span></a> : <span></span>}
      {next ? <a href={`${base}/${next.slug}/`} class="next"><span class="small muted">다음 편 →</span><span class="t">{next.label} {next.title}</span></a> : <a href={`${base}/`} class="next"><span class="small muted">끝</span><span class="t">목차로</span></a>}
    </nav>
  </article>
</Base>

<style>
  .chapter { max-width: 640px; margin: 0 auto; }
  .crumb a { text-decoration: none; }
  .label { margin-top: 24px; color: var(--accent-ink); letter-spacing: .04em; }
  h1 { font-size: clamp(28px, 4.5vw, 36px); margin-top: 6px; }
  /* 웹소설 호흡: 짧은 문단, 넉넉한 줄 간격 */
  .novel { margin-top: 40px; font-size: 17px; line-height: 1.9; color: var(--ink); word-break: keep-all; overflow-wrap: break-word; }
  .novel :global(p) { margin: 0 0 1.1em; }
  .novel :global(h2) { margin: 3em 0 1.4em; padding-top: 1.6em; border-top: 1px solid var(--line); font-size: 19px; text-align: center; color: var(--ink-2); }
  .novel :global(hr) { border: 0; margin: 2.4em 0; text-align: center; }
  .novel :global(hr)::after { content: '· · ·'; color: var(--muted); }
  .novel :global(blockquote) { margin: 1.4em 0; padding-left: 16px; border-left: 2px solid var(--accent); color: var(--ink-2); }
  .pager { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; }
  .pager a:hover { border-color: var(--ink-2); color: inherit; }
  .pager .next { text-align: right; }
  .pager .t { font-weight: 500; font-size: 15px; }
</style>
