---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts, games, postsFor } from '../../lib/data.js';

// 모든 게임의 글을 한데 모은 목록. 게임별 블로그는 /games/<게임>/blog/
const withPosts = games.filter((g) => postsFor(g.slug).length > 0);
---
<Base title="블로그" description="게임 개발 이야기, Unity 팁, 회고">
  <h1>블로그</h1>
  <p class="lead">모든 게임의 개발 일지를 날짜순으로 모았어요.</p>
  {withPosts.length > 0 && (
    <p class="by small">
      <span class="muted">게임별로 보기</span>
      {withPosts.map((g) => <a href={`/games/${g.slug}/blog/`}>{g.title} <span class="muted">{postsFor(g.slug).length}</span></a>)}
    </p>
  )}
  {posts.length === 0 ? (
    <p class="empty" style="margin-top: 32px">아직 쓴 글이 없어요.</p>
  ) : (
    <PostList posts={posts} showGame />
  )}
</Base>

<style>
  h1 { font-size: 36px; }
  .lead { margin-top: 10px; color: var(--ink-2); font-size: 17px; }
  .by { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; }
  .by a { color: var(--accent-ink); font-weight: 500; text-decoration: none; }
</style>
