---
import Base from '../../layouts/Base.astro';
import { posts, fmtDate } from '../../lib/data.js';
---
<Base title="블로그" description="게임 개발 이야기, Unity 팁, 회고">
  <h1>블로그</h1>
  <p class="lead">게임 개발 이야기, Unity 팁, 회고를 적어요.</p>
  {posts.length === 0 ? (
    <p class="empty" style="margin-top: 32px">아직 쓴 글이 없어요.</p>
  ) : (
    <ul class="list">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`}>
            <time class="mono small muted" datetime={p.date}>{fmtDate(p.date, true)}</time>
            <span class="t">{p.title}</span>
            {p.description && <span class="d small muted">{p.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 { font-size: 36px; }
  .lead { margin-top: 10px; color: var(--ink-2); font-size: 17px; }
  .list { list-style: none; margin: 32px 0 0; padding: 0; max-width: 760px; }
  .list a { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: 2px 16px; padding: 18px 0; border-bottom: 1px solid var(--line-2); text-decoration: none; }
  .t { font-weight: 500; font-size: 17px; }
  .d { grid-column: 2; }
  @media (max-width: 560px) { .list a { grid-template-columns: minmax(0, 1fr); } .d { grid-column: 1; } }
</style>
