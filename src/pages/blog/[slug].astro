---
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { posts } from '../../lib/data.js';

// 게임에 속하지 않는 글(src/posts/*.md)은 여기서 보여 준다.
// 게임 글은 /games/<게임>/blog/<글>/ 로 옮겼으므로, 예전 주소 /blog/<글>/ 로 오면 새 주소로 넘긴다
// (같은 이름의 글이 여러 게임에 있으면 먼저 만든 게임 — order가 작은 쪽 — 것으로).
export function getStaticPaths() {
  const general = posts.filter((p) => !p.game);
  const paths = general.map((post, i) => ({ params: { slug: post.slug }, props: { post, prev: general[i + 1], next: general[i - 1] } }));
  const taken = new Set(general.map((p) => p.slug));
  // posts는 날짜순이라, 옛 주소를 쓰던 가장 오래된 글이 이기도록 뒤에서부터 본다
  for (const p of [...posts].reverse().filter((x) => x.game)) {
    if (taken.has(p.slug)) continue;
    taken.add(p.slug);
    paths.push({ params: { slug: p.slug }, props: { to: p.url } });
  }
  return paths;
}
const { post, prev, next, to } = Astro.props;
if (to) return Astro.redirect(to);
---
<Base title={post.title} description={post.description}>
  <PostArticle post={post} prev={prev} next={next} back={{ href: '/blog/', label: '블로그' }} />
</Base>
